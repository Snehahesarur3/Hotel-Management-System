# Committed, non-secret defaults. Override locally in .env.local (git-ignored).

# Spring Boot API base URL (used only when mock mode is disabled)
VITE_API_BASE_URL=http://localhost:8080/api

# true  -> centralized in-browser mock services (localStorage persistence, no backend needed)
# false -> Axios calls to the Spring Boot REST API (backend is the source of truth)
VITE_MOCK_API_ENABLED=true

# Simulated network latency for mock services, in milliseconds
VITE_MOCK_LATENCY_MS=300

# The hotel's time zone: "today" follows the hotel's calendar, not the browser's. Must match the backend's app.timezone.
VITE_HOTEL_TIMEZONE=Asia/Kolkata
